# Garmin Connect credentials
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Notifications — configure at least one
# Email (Gmail recommended)
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Slack incoming webhook URL (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ntfy.sh push notifications — pick a unique topic name (optional)
NTFY_TOPIC=healthcheck-yourname-abc123

# Google Calendar (optional) — see scripts/setup_google_auth.py
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_TOKEN=

# Settings
HISTORY_DAYS=14
NOTIFY_ON_HEALTHY=false
